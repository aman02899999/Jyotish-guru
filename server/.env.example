# Postgres connection, via Supabase (or any Postgres host). Get both from the
# Supabase Dashboard: Project Settings -> Database -> Connection string.
# - DATABASE_URL: the "Transaction" pooler (port 6543, includes
#   ?pgbouncer=true) - what the app uses at runtime, since serverless
#   functions open many short-lived connections and need pooling.
# - DATABASE_URL_DIRECT: the direct connection (port 5432, no pgbouncer) -
#   only used by `prisma migrate`/`db push`, which need a real connection
#   (pgbouncer's transaction mode doesn't support the prepared statements
#   migrations use).
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL_DIRECT="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Required for AI-generated reports, daily horoscopes, and FAQ answers.
# Get a key at https://aistudio.google.com/apikey
# Without this set, the app runs fully (auth, dashboard, Panchang, billing
# demo) but report/horoscope text will show a "not configured" message.
GEMINI_API_KEY=""

# Required by NextAuth (Auth.js) to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-random-secret"

# Firebase Auth (Google Sign-In). Optional - the app works fine with just
# email/password if these are left blank. Get these from the Firebase
# Console: Project settings -> General -> Your apps -> Web app. These are
# all public client config values, safe to expose in the browser bundle
# (that's why they're NEXT_PUBLIC_ - no service account key is needed here,
# ID tokens are verified server-side against Google's public keys).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Razorpay (real payments). Optional - without these, subscriptions/credits/
# report checkout fall back to the clearly-labeled sandbox flow that just
# grants instantly with no payment. Get both from the Razorpay Dashboard:
# Settings -> API Keys. Use a rzp_test_... key while developing - it behaves
# identically but no real money moves. RAZORPAY_KEY_SECRET is a real secret:
# never commit it, never expose it to the browser (unlike the Firebase vars
# above, this one is NOT prefixed NEXT_PUBLIC_ on purpose).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
