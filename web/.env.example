# SQLite database file used by Prisma. The default is fine for local dev.
DATABASE_URL="file:./dev.db"

# Required for AI-generated reports, daily horoscopes, and FAQ answers.
# Get a key at https://aistudio.google.com/apikey
# Without this set, the app runs fully (auth, dashboard, Panchang, billing
# demo) but report/horoscope text will show a "not configured" message.
GEMINI_API_KEY=""

# Required by NextAuth (Auth.js) to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-random-secret"

# Firebase Auth (Google Sign-In). Optional - the app works fine with just
# email/password if these are left blank. Get these from the Firebase
# Console: Project settings -> General -> Your apps -> Web app. These are
# all public client config values, safe to expose in the browser bundle
# (that's why they're NEXT_PUBLIC_ - no service account key is needed here,
# ID tokens are verified server-side against Google's public keys).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
